# dependencies / build
node_modules/
dist/
*.log
.DS_Store

# secrets & local env (never commit)
.env
.env.local
.env.*.local

# vercel local
.vercel/

# Generated app icons. EVERY file in web/public/icons is produced by
# web/scripts/gen-icons.cjs, which now runs before both `npm run build` and
# `npm run dev`. Committing them only ever produced drift between the checked-in
# art and the generator that defines it. If you ever add a hand-made asset in
# there, un-ignore it explicitly - it will be invisible to git otherwise.
web/public/icons/

# Design mockups (activity-proposal.html, news-proposal.html, ...). Built from a
# snapshot of the live data, delivered for review, then summarised in the project
# docs. The shipped code and the findings write-up are what outlive them; keeping
# the mockup would leave a picture of a proposal sitting next to the
# implementation that superseded it.
*-proposal.html

# Review screenshots, same reasoning: captured from a build, delivered with the
# file-sending tool, then superseded by the next capture. Root only - web/public
# and the generated icons are tracked and must stay that way.
/*.png
