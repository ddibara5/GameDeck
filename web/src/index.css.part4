4px 16px;
  margin: 12px 16px;
  box-shadow: var(--shadow);
}

.chart-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0 0 12px;
}

.bar-row {
  display: grid;
  grid-template-columns: 96px 1fr auto;
  align-items: center;
  gap: 10px;
  margin: 9px 0;
}

.bar-label {
  font-size: 13px;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bar-track {
  display: block;
  height: 10px;
  border-radius: 999px;
  background: var(--surface-2);
  overflow: hidden;
}

.bar-fill {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: var(--accent);
  min-width: 2px;
  transition: width 0.4s ease;
}

.bar-value {
  font-size: 12.5px;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  min-width: 44px;
  text-align: right;
}

.chart-empty {
  font-size: 13px;
  color: var(--muted);
  padding: 4px 0 2px;
}

/* ---------- Richer game detail ---------- */

.detail-extra {
  margin-top: 6px;
}

.detail-extra-loading {
  display: block;
  color: var(--muted);
  font-size: 13px;
  padding: 12px 0;
}

.detail-blurb {
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.5;
  margin: 10px 0 2px;
}

.detail-source {
  font-size: 11px;
  color: var(--muted);
  opacity: 0.8;
}

/* ---------- Status picker + badges ---------- */

.status-picker {
  display: flex;
  gap: 6px;
  margin: 14px 0 6px;
  flex-wrap: wrap;
}

.status-btn {
  flex: 1 1 auto;
  min-height: 38px;
  padding: 0 10px;
  border-radius: 10px;
  border: 1px solid var(--line);
  background: var(--surface-2);
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.status-btn.active {
  border-color: var(--accent);
  color: var(--bg);
  background: var(--accent);
}

.detail-percent-label {
  font-size: 12px;
  font-weight: 600;
  color: var(--muted);
  margin-left: 8px;
  letter-spacing: 0.02em;
}

.status-badge {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.03em;
  padding: 1px 7px;
  border-radius: 999px;
  text-transform: uppercase;
  border: 1px solid var(--line);
  white-space: nowrap;
}

.status-badge.status-finished {
  color: #5dcaa5;
  border-color: #1d9e75;
  background: rgba(29, 158, 117, 0.12);
}

.status-badge.status-abandoned {
  color: var(--muted);
  border-color: var(--line);
  background: var(--surface-2);
}

/* ============================================================
   Native control color scheme (selects, scrollbars, form fields)
   ============================================================ */
:root {
  color-scheme: dark;
}

/* ============================================================
   LIGHT THEME
   Warm-paper japandi palette. Redefines the :root tokens and the
   handful of hardcoded colors. Activated by data-theme="light"
   on <html> (set by src/lib/theme.js).
   ============================================================ */
:root[data-theme="light"] {
  color-scheme: light;

  --bg: #efe8dd;
  --surface: #f6f1e9;
  --surface-2: #fdfaf4;
  --line: #e3dacb;
  --text: #2c2823;
  --muted: #857b6d;
  --walnut: #6f4e37;
  --walnut-light: #8a6a4f;
  --accent: #9c7449;
  --amber: #c2700f;
  --xbox: #107c10;
  --psn: #0f3fa8;
  --steam: #2f83bd;
  --shadow: 0 1px 2px rgba(60, 50, 40, 0.08);
}

/* Hardcoded-color selectors that don't read from tokens */
[data-theme="light"] .brand-caret { color: #b3a898; }
[data-theme="light"] .drawer-scrim { background: rgba(40, 34, 28, 0.32); }
[data-theme="light"] .drawer {
  background: #f8f4ec;
  border-right-color: #e3dacb;
  box-shadow: 8px 0 40px rgba(60, 45, 30, 0.14);
}
[data-theme="light"] .menu-sec-label { color: #9a8f7e; }
[data-theme="light"] .menu-item:active { background: rgba(60, 45, 30, 0.05); }
[data-theme="light"] .menu-item .menu-chev { color: #b3a898; }
[data-theme="light"] .menu-foot { color: #9a8f7e; }
[data-theme="light"] .chat-bubble.error { border-color: #d8a3a3; color: #b04a4a; }
[data-theme="light"] .status-badge.status-finished {
  color: #0f7a58;
  border-color: #1d9e75;
  background: rgba(29, 158, 117, 0.12);
}

/* ============================================================
   Appearance (theme) control in the drawer
   ============================================================ */
.menu-appearance {
  padding: 8px 12px 4px;
}

.menu-appearance-head {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 0 10px;
}

.menu-appearance-head .menu-icon {
  width: 20px;
  height: 20px;
  color: var(--accent);
  flex: none;
}

.menu-appearance-head .menu-label {
  font-size: 15px;
}

.seg {
  display: flex;
  gap: 4px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 4px;
}

.seg-btn {
  flex: 1;
  appearance: none;
  border: none;
  background: none;
  color: var(--muted);
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 0;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.seg-btn.active {
  background: var(--accent);
  color: var(--bg);
}
