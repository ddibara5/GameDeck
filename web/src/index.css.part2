color: var(--muted);
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
}

.chip.active {
  color: var(--bg);
  background: var(--accent);
  border-color: var(--accent);
  font-weight: 600;
}

.sort-row {
  margin-top: 10px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

.sort-select {
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 10px;
  padding: 8px 10px;
  font-size: 13px;
  min-height: 40px;
}

/* ---------- Stats strip ---------- */

.stats-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  padding: 14px 16px;
}

.stat-cell {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 10px 8px;
  text-align: center;
  box-shadow: var(--shadow);
}

.stat-value {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
  line-height: 1.2;
}

.stat-label {
  font-size: 10.5px;
  color: var(--muted);
  margin-top: 2px;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

/* ---------- Game list & cards ---------- */

.game-list {
  display: flex;
  flex-direction: column;
  padding: 4px 16px 16px;
  gap: 10px;
}

.show-more-row {
  display: flex;
  justify-content: center;
  padding: 0 16px 24px;
}

.show-more-btn {
  width: 100%;
  max-width: 320px;
  min-height: 44px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--accent);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.show-more-btn:active {
  background: var(--surface-2);
}

.game-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 10px;
  box-shadow: var(--shadow);
  cursor: pointer;
  min-height: 44px;
  text-align: left;
  width: 100%;
}

.game-card:active {
  background: var(--surface-2);
}

.game-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.game-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.platform-row {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--muted);
}

.platform-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex: 0 0 auto;
  display: inline-block;
}

.game-meta-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--muted);
}

/* ---------- Cover / thumbnail ---------- */

.cover {
  flex: 0 0 auto;
  border-radius: 10px;
  overflow: hidden;
  background: var(--walnut);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  font-weight: 700;
  position: relative;
}

.cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cover-sm {
  width: 52px;
  height: 52px;
  font-size: 20px;
}

.cover-lg {
  width: 100%;
  max-width: 240px;
  margin: 0 auto 4px;
  aspect-ratio: 3 / 4;
  border-radius: 16px;
  font-size: 48px;
}

/* ---------- Completion bar ---------- */

.completion-bar-track {
  width: 100%;
  height: 6px;
  border-radius: 999px;
  background: var(--surface-2);
  overflow: hidden;
}

.completion-bar-fill {
  height: 100%;
  border-radius: 999px;
  background: var(--accent);
  transition: width 0.3s ease;
}

/* ---------- Skeletons ---------- */

.skeleton {
  background: linear-gradient(90deg, var(--surface) 25%, var(--surface-2) 37%, var(--surface) 63%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.4s ease infinite;
  border-radius: 8px;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 10px;
}

.skeleton-cover {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  flex: 0 0 auto;
}

.skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeleton-line {
  height: 10px;
  width: 100%;
}

.skeleton-line.short {
  width: 40%;
}

/* ---------- Empty / loading state ---------- */

.empty-state {
  text-align: center;
  padding: 48px 24px;
  color: var(--muted);
}

.empty-state-title {
  color: var(--text);
  font-weight: 600;
  margin-bottom: 6px;
}

/* ---------- Modal / detail sheet ---------- */

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(10, 9, 8, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  animation: fade-in 0.15s ease;
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-sheet {
  width: 100%;
  max-width: 640px;
  max-height: 88vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior: contain;
  background: var(--surface);
  border-radius: 20px 20px 0 0;
  border-top: 1px solid var(--line);
  padding: 16px 20px calc(24px + var(--safe-bottom));
  animation: slide-up 0.2s ease;
}

@keyframes slide-up {
  from {
    transform: translateY(16px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-handle {
  width: 40px;
  height: 4px;
  border-radius: 999px;
  background: var(--line);
  margin: 0 auto 14px;
}

.sheet-drag-zone {
  touch-action: none;
  cursor: grab;
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 16px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--surface-2);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 16px;
}

.detail-title {
  font-size: 20px;
  font-weight: 700;
  margin: 14px 0 4px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
}

.detail-row + .detail-row {
  border-top: 1px solid var(--line);
}

.detail-label {
  color: var(--muted);
  font-size: 13px;
}

.detail-value {
  color: var(--text);
  font-size: 14px;
  font-weight: 600;
  text-align: right;
}

.detail-percent {
  font-size: 34px;
  font-weight: 700;
  color: var(--accent);
  margin: 4px 0 2px;
}

.detail-link {
  display: block;
  text-align: center;
  margin-top: 18px;
  padding: 13px;
  border-radius: 12px;
  border: 1px solid var(--walnut-light);
  color: var(--accent);
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  min-height: 44px;
}

/* ---------- Activity tab ---------- *